# Server-only Neon connection strings. Never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require

# DKG edge node. Two transports, selected by DKG_CLI_BIN:
#  - local daemon:  DKG_CLI_BIN=dkg
#  - EC2 / remote:  DKG_CLI_BIN=./scripts/dkg-remote-cli.bat (Windows dev)
#                   DKG_CLI_BIN=./scripts/dkg-remote-cli     (Linux / Render)
# Only endpoints and public addresses go here — never private keys.
# DKG_MODE=edge
# DKG_ENDPOINT_LABEL=EC2 edge node (52.58.167.195 via SSH)
# DKG_SSH_HOST=52.58.167.195
# DKG_SSH_USER=harsh
# Local dev uses a key *file*:
# DKG_SSH_KEY=C:\Users\harsh\.ssh\id_ed25519_dkg_ec2
# Hosted envs (Render/Vercel dashboards) use the key *content* instead:
# DKG_SSH_KEY_INLINE=-----BEGIN OPENSSH PRIVATE KEY----- ...
# DKG_CONTEXT_GRAPH=permitframe-acceptance-20260919
# DKG_CONTEXT_GRAPH_ID=0x31c83Ac625c29Ef7F4fabDB49ee68Fb56B06977c/permitframe-acceptance-20260919

# Privy: App ID is intentionally public; App Secret is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
