# Server-only Neon connection strings. Never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require

# Privy: App ID is intentionally public; App Secret is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
